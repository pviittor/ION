		{
			"name": "4. Train Model - Complete Example",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Training completed\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('message');",
							"    pm.expect(jsonData.message).to.include('concluído');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"ddl_statements\": [\n    \"CREATE TABLE usuarios (id INT PRIMARY KEY AUTO_INCREMENT, nome VARCHAR(100) NOT NULL, email VARCHAR(100) UNIQUE, data_cadastro DATE, ativo BOOLEAN DEFAULT TRUE)\",\n    \"CREATE TABLE produtos (id INT PRIMARY KEY AUTO_INCREMENT, nome VARCHAR(100) NOT NULL, preco DECIMAL(10,2), categoria VARCHAR(50), estoque INT DEFAULT 0)\",\n    \"CREATE TABLE pedidos (id INT PRIMARY KEY AUTO_INCREMENT, usuario_id INT, data_pedido DATE, total DECIMAL(10,2), status VARCHAR(20) DEFAULT 'pendente', FOREIGN KEY (usuario_id) REFERENCES usuarios(id))\",\n    \"CREATE TABLE itens_pedido (id INT PRIMARY KEY AUTO_INCREMENT, pedido_id INT, produto_id INT, quantidade INT, preco_unitario DECIMAL(10,2), FOREIGN KEY (pedido_id) REFERENCES pedidos(id), FOREIGN KEY (produto_id) REFERENCES produtos(id))\"\n  ],\n  \"documentation\": [\n    \"A tabela usuarios contém informações dos clientes cadastrados no sistema de e-commerce\",\n    \"A tabela produtos mantém o catálogo de produtos disponíveis para venda\",\n    \"A tabela pedidos registra todos os pedidos realizados pelos usuários\",\n    \"A tabela itens_pedido detalha quais produtos foram incluídos em cada pedido\",\n    \"O campo total na tabela pedidos representa o valor total do pedido em reais\",\n    \"O campo categoria na tabela produtos pode ser: eletrônicos, roupas, livros, casa, esportes\",\n    \"O campo status na tabela pedidos pode ser: pendente, processando, enviado, entregue, cancelado\",\n    \"O campo ativo na tabela usuarios indica se o usuário está ativo no sistema\"\n  ],\n  \"sql_data\": [\n    {\n      \"question\": \"Quantos usuários temos cadastrados?\",\n      \"sql\": \"SELECT COUNT(*) FROM usuarios\"\n    },\n    {\n      \"question\": \"Qual o total de vendas?\",\n      \"sql\": \"SELECT SUM(total) FROM pedidos WHERE status = 'entregue'\"\n    },\n    {\n      \"question\": \"Quais são os produtos mais caros?\",\n      \"sql\": \"SELECT nome, preco FROM produtos ORDER BY preco DESC LIMIT 10\"\n    },\n    {\n      \"question\": \"Quantos pedidos foram feitos hoje?\",\n      \"sql\": \"SELECT COUNT(*) FROM pedidos WHERE DATE(data_pedido) = CURDATE()\"\n    },\n    {\n      \"question\": \"Qual usuário fez mais pedidos?\",\n      \"sql\": \"SELECT u.nome, COUNT(p.id) as total_pedidos FROM usuarios u JOIN pedidos p ON u.id = p.usuario_id GROUP BY u.id ORDER BY total_pedidos DESC LIMIT 1\"\n    },\n    {\n      \"question\": \"Quais produtos estão em falta no estoque?\",\n      \"sql\": \"SELECT nome, estoque FROM produtos WHERE estoque = 0\"\n    },\n    {\n      \"question\": \"Qual o valor médio dos pedidos?\",\n      \"sql\": \"SELECT AVG(total) FROM pedidos WHERE status != 'cancelado'\"\n    },\n    {\n      \"question\": \"Quantos produtos temos por categoria?\",\n      \"sql\": \"SELECT categoria, COUNT(*) FROM produtos GROUP BY categoria\"\n    }\n  ]\n}"
				},
				"url": {
					"raw": "{{base_url}}/train",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"train"
					]
				},
				"description": "Treina o modelo Vanna.AI com um exemplo completo de e-commerce incluindo DDL statements, documentação e pares pergunta-SQL."
			},
			"response": []
		},
